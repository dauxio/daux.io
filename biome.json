{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noPrototypeBuiltins": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.scss"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnknownUnit": "off"
                    }
                }
            }
        }
    ]
}
